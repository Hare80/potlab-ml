# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- ML training artifacts ----
runs/*
!runs/.gitkeep
# Anchored to repo root: only the QM9 data folder, NOT the potlab/data/
# package (an un-anchored data/ would hit both).
# Note: gitignore treats only a line-starting # as a comment - inline
# comments after a pattern are parsed as part of the pattern itself.
/data/
*.pt
*.pth

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDEs ----
.vscode/
.idea/

# ---- OS junk ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- LAMMPS artifacts ----
log.lammps
