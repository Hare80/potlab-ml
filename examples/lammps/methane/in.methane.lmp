# Methane MD driven by a PaiNN model through pair_style mliap unified.
# Build methane_painn.pkl first with scripts/make_mliap_pickle.py
# (see README.md in this folder); the --elements list must match the
# pair_coeff type order below.

units metal
atom_style atomic
boundary f f f

read_data methane.data

pair_style mliap unified methane_painn.pkl 0
pair_coeff * * C H

neighbor 1.0 bin
neigh_modify every 1 delay 0 check no

fix 1 all nve
velocity all create 100.0 4928459 loop geom
timestep 0.0001
thermo 10
thermo_style custom step temp pe etotal

run 100
